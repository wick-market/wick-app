# ── Mock mode ──────────────────────────────────────────────────────────────────
# true  → all data served from src/mocks/fixtures/ with no backend needed.
#         The default. npm run dev works with no .env file at all.
# false → real API + WebSocket (requires backend running or deployed).
NEXT_PUBLIC_MOCK=true

# ── Backend URLs (only needed when NEXT_PUBLIC_MOCK=false) ─────────────────────
# REST + WebSocket base URL from wick-protocol deployment
# NEXT_PUBLIC_API_URL=https://wick-api.onrender.com
# NEXT_PUBLIC_WS_URL=wss://wick-api.onrender.com/ws

# ── Stellar network ────────────────────────────────────────────────────────────
# TESTNET only. Do not change this.
NEXT_PUBLIC_NETWORK=testnet
